# Supabase — get these from app.supabase.com > Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google OAuth — get from console.cloud.google.com > Credentials > OAuth 2.0 Client ID
# Set Authorized JavaScript Origins to your Netlify URL
VITE_GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Anthropic API — get from console.anthropic.com
# This goes in Netlify environment variables (NOT in .env — never expose this key)
ANTHROPIC_API_KEY=sk-ant-...
